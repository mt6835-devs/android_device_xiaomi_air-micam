binder_use(priv_app)
binder_call(priv_app, hal_camera_default)

hal_client_domain(priv_app, hal_mtk_bgs)

allow priv_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow priv_app vendor_camera_data_file:file { getattr open read };

# Properties
get_prop(priv_app, vendor_camera_prop)
get_prop(priv_app, vendor_camera_persist_prop)
get_prop(priv_app, vendor_mtk_audio_prop)
get_prop(priv_app, vendor_mi_prop)
