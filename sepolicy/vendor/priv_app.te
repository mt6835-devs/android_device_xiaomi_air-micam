binder_use(priv_app_36)
binder_call(priv_app_36, hal_camera_default)

allow priv_app_36 hal_aidlbgservice_service:service_manager find;
allow priv_app_36 hal_camera_service:service_manager find;
allow priv_app_36 mtk_hal_bgs_hwservice:hwservice_manager find;

allow priv_app_36 adsprpcd_file:dir { open read search };

allow priv_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow priv_app_36 vendor_camera_data_file:file { getattr open read };

allow priv_app_36 app_data_file:file execute;

# Properties
get_prop(priv_app_36, vendor_audio_prop)
get_prop(priv_app_36, vendor_camera_p3enable_prop)
get_prop(priv_app_36, vendor_camera_sensor_prop)
get_prop(priv_app_36, vendor_camera_prop)
get_prop(priv_app_36, vendor_camera_persist_prop)
get_prop(priv_app_36, vendor_display_prop)
get_prop(priv_app_36, vendor_displayfeature_prop)
get_prop(priv_app_36, vendor_panel_info_prop)
get_prop(priv_app_36, vendor_mi_prop)
get_prop(priv_app_36, vendor_default_prop)
